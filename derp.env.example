# ==============================================================================
# derp-bootstrap 配置文件模板
# 使用方法：
#   cp derp.env.example derp.env && chmod 600 derp.env
# 注意事项：
#   请勿将填有真实密钥的 derp.env 提交到 Git 仓库或泄露给他人。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 必填项
# ------------------------------------------------------------------------------

# 已解析到当前 VPS 公网 IP 的完整域名（不要带 https://，且不要开启 CDN 小云朵代理）
DERP_HOSTNAME=derp-sg.example.com

# Tailscale 授权密钥（以 tskey-auth- 开头）
# 获取地址：https://login.tailscale.com/admin/settings/keys
# 注：若 VPS 已经提前登录过 Tailscale，此项可留空；首次自动入网成功后，服务器上的密钥会被自动擦除。
TS_AUTHKEY=tskey-auth-xxxxxxxx

# ------------------------------------------------------------------------------
# 2. 节点与区域标识（建议按实际地域修改）
# ------------------------------------------------------------------------------

# Tailscale 设备列表中显示的机器名（留空则默认使用域名前缀，如 derp-sg）
TS_HOSTNAME=derp-sg

# 节点宣告的 ACL 标签（需提前在 Tailscale ACL 的 tagOwners 中声明；若不使用标签可留空）
TS_ADVERTISE_TAGS=tag:derp

# 自定义 DERP 区域 ID（Tailscale 规定自定义区间为 900–999）
# 每个 RegionID 只能对应一个区域；部署多台 DERP 时请依次递增（如 900、901、902）
DERP_REGION_ID=900

# 区域短代号与名称（在 tailscale netcheck 中显示）
DERP_REGION_CODE=sg
DERP_REGION_NAME=Singapore

# ------------------------------------------------------------------------------
# 3. 高级可选项（保持默认即可，一般无需修改）
# ------------------------------------------------------------------------------

# Let's Encrypt 证书通知邮箱（可留空）
ACME_EMAIL=

# 端口配置（若修改端口，请同步在云安全组/防火墙中放行对应端口）
DERP_PORT=443
DERP_HTTP_PORT=80
DERP_STUN_PORT=3478

# 是否校验客户端身份（true = 仅允许自己 Tailnet 内的设备使用，强烈建议保持 true）
DERP_VERIFY_CLIENTS=true

# 手动指定本机公网 IPv4（留空则由脚本自动探测）
PUBLIC_IPV4=
