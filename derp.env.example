# derp-bootstrap 配置表
# 复制为 derp.env 后再填写：cp derp.env.example derp.env && chmod 600 derp.env
# 不要把填好的 derp.env 发给别人，也不要上传到 Git。

# —— 必填 ——
# 已解析到这台 VPS 公网 IP 的完整域名（不要带 https://）
DERP_HOSTNAME=derp-sg.example.com

# Tailscale 授权密钥，以 tskey-auth- 开头。只在生成时显示一次。
TS_AUTHKEY=tskey-auth-xxxxxxxx

# —— 建议填写 ——
# Tailscale 里显示的设备名，建议和域名左侧一致
TS_HOSTNAME=derp-sg

# 写入 Tailscale ACL 的标签，需与准备工作里的 tagOwners 一致
TS_ADVERTISE_TAGS=tag:derp

# 自定义 DERP 区域，必须在 900–999。每台 VPS 用不同的 RegionID。
# 第一台用 900，第二台用 901，不要复用已有的 ID。
DERP_REGION_ID=900
DERP_REGION_CODE=sg
DERP_REGION_NAME=Singapore

# —— 可选 ——
# Let's Encrypt 联系邮箱，可留空
ACME_EMAIL=
