# ==============================================================================
# derp-bootstrap 普通设备 / 客户端节点配置文件模板（--client 模式）
# 使用方法：
#   cp client.env.example client.env && chmod 600 client.env
# 注意事项：
#   请勿将填有真实密钥的 client.env 提交到 Git 仓库或泄露给他人。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 必填项
# ------------------------------------------------------------------------------

# Tailscale 授权密钥（以 tskey-auth- 开头）
# 获取地址：https://login.tailscale.com/admin/settings/keys
# 注：若设备已经提前登录过 Tailscale，此项可留空；首次自动入网成功后，设备上的密钥会被自动擦除。
TS_AUTHKEY=tskey-auth-xxxxxxxx

# ------------------------------------------------------------------------------
# 2. 节点标识（按需修改）
# ------------------------------------------------------------------------------

# Tailscale 设备列表中显示的机器名（留空则默认使用当前系统主机名）
# 注意：只能包含字母、数字和连字符（-），不能包含下划线（_），例如 compute-test
TS_HOSTNAME=

# 节点宣告的 ACL 标签（需提前在 Tailscale ACL 的 tagOwners 中声明；不使用标签可留空）
# 例如：tag:compute 或 tag:server
TS_ADVERTISE_TAGS=

# ------------------------------------------------------------------------------
# 3. 网络与 SSH 选项（一般保持默认即可）
# ------------------------------------------------------------------------------

# 是否开启 Tailscale SSH（true = 允许通过 Tailscale 直接免密 SSH 登录此设备）
TS_SSH=true

# 是否接受 Tailscale MagicDNS（true = 可直接用设备名互访）
TS_ACCEPT_DNS=true

# 是否接受其他节点宣告的子网路由（一般设备保持 false，按需开启）
TS_ACCEPT_ROUTES=false
